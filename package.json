{
    "name": "home",
    "version": "0.1.0",
    "license": "Apache-2.0",
    "private": true,
    "type": "module",
    "description": "allurx 的个人主页与作品入口。",
    "engines": {
        "node": "24.x"
    },
    "scripts": {
        "dev": "vite --open --host 0.0.0.0",
        "format": "prettier . --write",
        "format:check": "prettier . --check",
        "lint": "eslint . --max-warnings 0",
        "type-check": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
        "check": "npm run format:check && npm run lint && npm run type-check",
        "build": "npm run check && vite build",
        "verify": "npm run build",
        "preview": "wrangler dev",
        "deploy": "wrangler deploy"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@types/node": "24.19.1",
        "eslint": "10.12.0",
        "prettier": "3.9.9",
        "typescript": "6.0.3",
        "typescript-eslint": "8.71.0",
        "vite": "8.3.1",
        "wrangler": "4.145.0"
    },
    "prettier": {
        "tabWidth": 4,
        "printWidth": 120,
        "semi": true,
        "singleQuote": false,
        "endOfLine": "lf",
        "embeddedLanguageFormatting": "auto",
        "trailingComma": "es5"
    },
    "allowScripts": {
        "esbuild@0.28.1": true,
        "workerd@1.20260930.2": true
    }
}
